{
  "name": "navi",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "tsx watch src/server/node.ts",
    "dev:web": "vite",
    "start": "node dist/server/node.js",
    "build": "pnpm run build:web",
    "build:web": "vite build",
    "build:server": "vite build -c vite.server.config.ts && node scripts/copy-migrations.mjs",
    "build:docker": "pnpm run build:web && pnpm run build:server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "vue-tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "vitest run -c web/vitest.config.ts",
    "test:all": "pnpm test && pnpm run test:web",
    "check": "pnpm run typecheck && pnpm run typecheck:web && pnpm run lint && pnpm run test:all",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist node_modules pnpm-lock.yaml"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.28",
    "music-metadata": "^11.13.0",
    "pinia": "^3.0.4",
    "rimraf": "^6.1.3",
    "undici": "^8.9.0",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.107.1"
  }
}
